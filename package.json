{
  "name": "telegram-claude-bridge",
  "version": "1.0.0",
  "description": "Telegram Bot Bridge for Claude Code",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "bg": "node bridge.mjs start",
    "bg:stop": "node bridge.mjs stop",
    "bg:restart": "node bridge.mjs restart",
    "bg:status": "node bridge.mjs status",
    "bg:log": "node bridge.mjs log"
  },
  "dependencies": {
    "telegraf": "^4.16.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
