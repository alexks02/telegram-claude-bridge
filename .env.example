# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# REQUIRED. Absolute path of the folder that holds your repositories — the bridge
# scans only this, and every direct subdirectory with a .git becomes a project.
WORKSPACE_ROOT=/absolute/path/to/your/code

# Project selected at startup: an alias, name or substring.
# Optional — defaults to the first project found (or, if the bridge is nested
# inside a project, that one). Switch at runtime with /project.
# DEFAULT_PROJECT=my-frontend

# Short names for projects, so /project <alias> resolves to a directory.
# Comma-separated alias:directory pairs. Optional — there are no built-in ones.
# ALIASES=api:my-backend,web:my-frontend

# Full path to the Claude Code CLI. A full path, not a bare name — a detached
# bridge often has a stripped PATH that a bare "claude" would not resolve against.
# The line below is the macOS default; uncomment the one for your OS instead.
CLAUDE_CLI=/Users/you/.local/bin/claude
# MacOS:   CLAUDE_CLI=/Users/you/.local/bin/claude
# Linux:   CLAUDE_CLI=/home/you/.local/bin/claude
# Windows: CLAUDE_CLI=C:\Users\you\.local\bin\claude.exe

# How long one Claude run may take, in milliseconds.
# Optional — defaults to 600000 (10 minutes); real tasks routinely need minutes.
# CLAUDE_TIMEOUT_MS=600000
